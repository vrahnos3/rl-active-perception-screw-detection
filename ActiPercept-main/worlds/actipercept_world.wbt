              appearance PBRAppearance {
                baseColor 1 0 0
                metalness 0
              }
              geometry Box {
                size 0.02 0.1 0.1
              }
            }
          ]
          name "camera_shape"
        }
      ]
      width 480
      height 270
    }
  ]
  controller "<extern>"
  supervisor TRUE
}
